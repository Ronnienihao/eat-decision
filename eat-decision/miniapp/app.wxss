/* app.wxss - 全局样式 */

/* 字体 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  background-color: #FAF7F2;
  color: #2D2D2D;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  background-color: #FAF7F2;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 40rpx rgba(0, 0, 0, 0.08);
  padding: 40rpx;
  margin-bottom: 24rpx;
}

/* 主按钮（橙色） */
.btn-primary {
  background: #FF6B35;
  color: #FFFFFF;
  border: none;
  border-radius: 100rpx;
  padding: 28rpx 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  width: 100%;
  box-sizing: border-box;
  transition: transform 0.2s;
}

.btn-primary:active {
  transform: scale(0.97);
}

/* 次要按钮（白色边框） */
.btn-secondary {
  background: transparent;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 100rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

/* 提示文字 */
.hint-text {
  color: #9CA3AF;
  font-size: 24rpx;
  text-align: center;
}

/* 标题 */
.title-xl {
  font-size: 56rpx;
  font-weight: 700;
  color: #2D2D2D;
  line-height: 1.3;
}

.title-lg {
  font-size: 40rpx;
  font-weight: 700;
  color: #2D2D2D;
  line-height: 1.4;
}

.title-md {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  background: #FFF0E8;
  color: #FF6B35;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin: 6rpx;
}

/* 淡入动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in-up {
  animation: fadeInUp 0.3s ease-out;
}
