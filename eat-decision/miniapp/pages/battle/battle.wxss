/* pages/battle/battle.wxss */

.battle-container {
  padding: 32rpx 32rpx 160rpx;
}

/* 标签栏 */
.tags-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
  justify-content: center;
}

/* 轮次信息 */
.round-info {
  text-align: center;
  margin-bottom: 40rpx;
  font-size: 26rpx;
}

/* PK 区域 */
.battle-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

/* 菜品卡片 */
.dish-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 40rpx rgba(0, 0, 0, 0.08);
  border: 3rpx solid transparent;
  transition: all 0.25s ease;
  text-align: center;
  cursor: pointer;
}

.dish-card:active {
  transform: scale(0.98);
}

.dish-card.dish-selected {
  border-color: #FF6B35;
  background: #FFF0E8;
  transform: scale(1.03);
}

.dish-card.dish-faded {
  opacity: 0.4;
  transform: scale(0.96);
}

.dish-badge {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 16rpx;
}

.challenger-badge {
  color: #6B7280;
}

.dish-card.dish-selected .dish-badge {
  color: #FF6B35;
}

.dish-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #2D2D2D;
  margin-bottom: 16rpx;
}

.dish-desc {
  font-size: 24rpx;
  line-height: 1.6;
}

/* VS 分隔 */
.vs-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  position: relative;
  z-index: 1;
}

.vs-circle {
  background: #FF6B35;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.4);
}

/* 0道菜兜底 */
.empty-card {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  margin-bottom: 16rpx;
}

.empty-desc {
  line-height: 1.8;
  margin-bottom: 48rpx;
}

.empty-btn {
  margin-top: 0;
}

.newline {
  display: block;
}

/* 催促 Toast */
.urge-toast {
  position: fixed;
  bottom: 160rpx;
  left: 50%;
  transform: translateX(-50%) translateY(20rpx);
  background: rgba(45, 45, 45, 0.85);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  white-space: nowrap;
  opacity: 0;
  transition: all 0.3s;
  pointer-events: none;
}

.urge-toast.toast-show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* 催促气泡 */
.urge-bubble {
  position: fixed;
  bottom: 60rpx;
  left: 32rpx;
  right: 32rpx;
  background: #2D2D2D;
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s;
  pointer-events: none;
  z-index: 100;
}

.urge-bubble.bubble-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.bubble-close {
  text-align: center;
  color: #FF6B35;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx;
  border: 2rpx solid #FF6B35;
  border-radius: 40rpx;
}
