/* pages/result/result.wxss */

.result-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 80rpx 40rpx;
  text-align: center;
}

.result-crown {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}

.result-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

.result-name {
  font-size: 72rpx;
  font-weight: 800;
  color: #FF6B35;
  margin-bottom: 32rpx;
  line-height: 1.2;
}

.result-desc {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
  font-style: italic;
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 64rpx;
}

.result-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-share-btn {
  background: transparent;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 100rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  width: 100%;
  box-sizing: border-box;
}

.restart-link {
  padding: 16rpx;
  cursor: pointer;
}
